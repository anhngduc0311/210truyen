# ==============================================================================
# CẤU HÌNH BIẾN MÔI TRƯỜNG CHO 210TRUYEN / TRUYENDEX
# Sao chép file này thành .env và điền các giá trị thực tế trước khi chạy:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Google OAuth & Google Drive
# ------------------------------------------------------------------------------
# Lấy từ Google Cloud Console -> APIs & Services -> Credentials
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
# Cấu hình Google Drive (tùy chọn / dự phòng)
GOOGLE_DRIVE_REFRESH_TOKEN=
GOOGLE_DRIVE_FOLDER_ID=

# ------------------------------------------------------------------------------
# 2. JWT Security Key
# ------------------------------------------------------------------------------
# Chuỗi bí mật dùng để ký và xác thực JWT token (BẮT BUỘC: tối thiểu 32 ký tự)
# Có thể sinh ngẫu nhiên bằng lệnh: openssl rand -hex 32
JWT_KEY=your_super_secret_jwt_key_at_least_32_characters_long

# ------------------------------------------------------------------------------
# 3. Web & API Ports (Cổng expose ra ngoài VPS / Host)
# ------------------------------------------------------------------------------
# Cổng truy cập Frontend (mặc định 80)
FRONTEND_PORT=80
# Cổng truy cập Backend API (mặc định 5080)
API_PORT=5080

# ------------------------------------------------------------------------------
# 4. PostgreSQL Database
# ------------------------------------------------------------------------------
# Cổng kết nối Postgres trên host (mặc định 54329 để tránh xung đột cổng 5432)
POSTGRES_PORT=54329
POSTGRES_DB=truyendex
POSTGRES_USER=truyendex
POSTGRES_PASSWORD=your_strong_postgres_password

# ------------------------------------------------------------------------------
# 5. Redis Cache
# ------------------------------------------------------------------------------
# Cổng kết nối Redis trên host (mặc định 63799 để tránh xung đột cổng 6379)
REDIS_PORT=63799
REDIS_PASSWORD=your_strong_redis_password

# ------------------------------------------------------------------------------
# 6. Meilisearch (Full-text Search Engine)
# ------------------------------------------------------------------------------
# Cổng kết nối Meilisearch trên host (mặc định 7709 để tránh xung đột cổng 7700)
MEILISEARCH_PORT=7709
# Master key của Meilisearch (tối thiểu 16 bytes)
MEILI_MASTER_KEY=your_meilisearch_master_key_min_16_chars
# Môi trường chạy Meilisearch: development | production
MEILI_ENV=production
